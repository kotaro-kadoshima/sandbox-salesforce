{
  "renderer": {
    "componentOverrides": {
      "$": {
        "definition": "@widget/c/accountPipelineCard",
        "attributes": {
          "id": "{!$attrs.outputValues.pipeline.id}",
          "name": "{!$attrs.outputValues.pipeline.name}",
          "industry": "{!$attrs.outputValues.pipeline.industry}",
          "billingCity": "{!$attrs.outputValues.pipeline.billingCity}",
          "openAmount": "{!$attrs.outputValues.pipeline.openAmount}",
          "openAmountLabel": "{!$attrs.outputValues.pipeline.openAmountLabel}",
          "openCount": "{!$attrs.outputValues.pipeline.openCount}",
          "opportunities": "{!$attrs.outputValues.pipeline.opportunities}",
          "accountRecordLink": "{!$attrs.outputValues.pipeline.accountRecordLink}"
        }
      }
    }
  }
}