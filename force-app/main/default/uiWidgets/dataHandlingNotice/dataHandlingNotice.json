{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": { "gap": "sm" },
          "children": [
            {
              "definition": "tile/row",
              "attributes": { "gap": "sm" },
              "children": [
                {
                  "definition": "tile/icon",
                  "attributes": { "name": "alert-triangle", "size": "sm", "color": "warning" }
                },
                {
                  "definition": "tile/text",
                  "attributes": { "text": "{!$attrs.noticeTitle}", "variant": "h3" }
                }
              ]
            },
            {
              "definition": "tile/text",
              "attributes": { "text": "{!$attrs.noticeConfidential}" }
            },
            {
              "definition": "tile/text",
              "attributes": { "text": "{!$attrs.noticeShareCheck}" }
            },
            {
              "definition": "tile/text",
              "attributes": { "text": "{!$attrs.noticeResponsibility}" }
            }
          ]
        }
      ]
    }
  }
}
